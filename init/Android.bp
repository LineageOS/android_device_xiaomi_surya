cc_library_static {
    name: "libinit_surya",
    srcs: ["init_surya.cpp"],
    recovery_available: true,
    include_dirs: [
        "system/core/init",
    ],
    shared_libs: ["libbase"],
}

prebuilt_etc {
    name: "init.surya.rc",
    src: "init.surya.rc",
    sub_dir: "init/hw",
    vendor: true,
}
