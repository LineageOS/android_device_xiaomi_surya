# Audio
aaudio.mmap_policy=2                          # sm6150: 1
ro.config.media_vol_steps=25
ro.vendor.audio.sdk.fluencetype=none
ro.vendor.audio.sfx.scenario=true
ro.vendor.audio.soundfx.usb=true
vendor.audio.hw.aac.encoder=true              # sm6150: false
vendor.voice.path.for.pcm.voip=true

# Camera
persist.vendor.camera.privapp.list=org.codeaurora.snapcam,com.android.camera,org.lineageos.snap

# Chipset
ro.soc.manufacturer=Qualcomm                  # sm6150: "QTI"
ro.soc.model=SM7150

# Display
persist.sys.sf.color_mode=0                   # sm6150: 9
vendor.display.qdcm.disable_factory_mode=1

# Display - Dynamic Refresh Rate
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.set_idle_timer_ms=500
ro.surface_flinger.set_touch_timer_ms=700
ro.surface_flinger.use_content_detection_for_refresh_rate=true
vendor.display.idle_time=1100

# Fingerprint
persist.vendor.fingerprint.type=side
persist.vendor.fingerprint.sensor_location=1080|920|220|local:4630946688386997377,1080|920|220|local:4630946772315683201

# HVDCP
persist.vendor.cp.fcc_main_ua=400000
persist.vendor.cp.taper_term_mv=6500
persist.vendor.cp.vbus_offset_mv=1040

# IMS
persist.vendor.ims.disableADBLogs=1
persist.vendor.ims.disableDebugLogs=1
persist.vendor.ims.disableIMSLogs=1
persist.vendor.ims.disableQXDMLogs=1

# Radio
persist.vendor.radio.redir_party_num=1