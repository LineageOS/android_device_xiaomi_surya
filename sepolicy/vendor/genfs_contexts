# Label wakeup nodes symlinks from /sys/class/wakeup
genfscon sysfs /devices/platform/soc/a8c000.i2c/i2c-2/2-0065/power_supply/bq2597x-standalone/wakeup                                                                                         u:object_r:sysfs_wakeup:s0                                                                                                     u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/input/input1/wakeup5 u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/input/input1/power/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/input/input1/wakeup5/total_time_ms u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/input/input1/wakeup5/wakeup_count u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/input/input1/wakeup5/max_time_ms u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/input/input1/wakeup5/event_count u:object_r:sysfs_wakeup:s0

# ds28e16 battery verify
genfscon sysfs /devices/platform/soc/a8c000.i2c/i2c-2/2-0065/power_supply/bq2597x-standalone/type    u:object_r:vendor_sysfs_battery_supply:s0

genfscon proc /last_kmsg u:object_r:proc_last_kmsg:s0

# Touchpanel
genfscon sysfs /touchpanel                                                           u:object_r:sysfs_touchpanel:s0
